@startuml

title ER-диаграма БД основной системы Warmhouse

'skinparam linetype ortho

' Сущности и их атрибуты
entity "User" {
  *id : Int <<PK>>
  --
  login: VARCHAR
  password: VARCHAR
  name : VARCHAR
  email : VARCHAR
  phone : VARCHAR
}

entity "House" {
  *id : Int <<PK>>
  --
  name : VARCHAR
  address : VARCHAR
}
User }o--o{ House : владеет (many-to-many)

entity "Device" {
  *id : Int <<PK>>
  --
  house_id : Int <<FK>>
  type_id : VARCHAR <<FK>>
  name : VARCHAR
  serial_number : VARCHAR
  url: VARCHAR
  enabled : bool
}
House ||--o{ Device : располагается

entity "DeviceType" {
  *id : VARCHAR <<PK>>
  --
  model : VARCHAR
  settings: JSON
}
DeviceType ||--o{ Device : является

entity "TemperatureSettings"{
  *id: Int <<PK>>
  --
  device_id: Int <<FK>>
  updated_at: DateTime
  target_value: VARCHAR
  enabled: bool
}
Device ||--|| "TemperatureSettings"


entity "TemperatureCaptures" {
  *id: Int <<PK>>
  --
  device_id: Int <<FK>>
  captured_at: DateTime
  value: VARCHAR
}
Device ||--o{ "TemperatureCaptures"

entity "GateStatus" {
  *id: Int <<PK>>
  --
  device_id: Int <<FK>>
  captured_at: DateTime
  value: VARCHAR
}
Device ||--o{ "GateStatus"

@enduml